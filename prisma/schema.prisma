generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id           Int        @id @default(autoincrement())
  nome         String
  sobrenome    String
  email        String     @unique
  telefone     String?
  senhaHash    String
  perfil       Perfil     @default(CLIENTE)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  versaoSessao Int        @default(1)
  carrinho     Carrinho?
  enderecos    Endereco[]
  pedidos      Pedido[]

  @@map("usuarios")
}

model Categoria {
  id           Int       @id @default(autoincrement())
  nome         String    @unique @db.VarChar(100)
  slug         String    @unique @db.VarChar(120)
  ativa        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  produtos     Produto[]

  @@map("categorias")
}

model Produto {
  id               Int               @id @default(autoincrement())
  nome             String            @db.VarChar(150)
  slug             String            @unique @db.VarChar(180)
  descricao        String?           @db.Text
  preco            Decimal           @db.Decimal(10, 2)
  precoPromocional Decimal?          @db.Decimal(10, 2)
  categoriaId      Int
  ativo            Boolean           @default(false)
  destaque         Boolean           @default(false)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  imagens          ImagemProduto[]
  categoria        Categoria         @relation(fields: [categoriaId], references: [id])
  variantes        VarianteProduto[]

  @@index([categoriaId])
  @@map("produtos")
}

model VarianteProduto {
  id                   Int                   @id @default(autoincrement())
  produtoId            Int
  tamanho              String                @db.VarChar(30)
  cor                  String                @db.VarChar(60)
  sku                  String?               @unique @db.VarChar(100)
  quantidade           Int                   @default(0)
  ativa                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  itensCarrinho        ItemCarrinho[]
  itensPedido          ItemPedido[]
  movimentacoesEstoque MovimentacaoEstoque[]
  produto              Produto               @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, tamanho, cor])
  @@map("variantes_produto")
}

model ImagemProduto {
  id        Int      @id @default(autoincrement())
  produtoId Int
  url       String   @db.VarChar(1000)
  textoAlt  String?  @db.VarChar(255)
  ordem     Int      @default(0)
  principal Boolean  @default(false)
  criadoEm  DateTime @default(now())
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, ordem])
  @@map("imagens_produto")
}

/// Endereços cadastrados pelos clientes da Pádua Culture.
/// Cada endereço pertence a um usuário.
model Endereco {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  apelido      String?  @db.VarChar(50)
  destinatario String   @db.VarChar(150)
  cep          String   @db.VarChar(8)
  logradouro   String   @db.VarChar(200)
  numero       String   @db.VarChar(20)
  complemento  String?  @db.VarChar(150)
  bairro       String   @db.VarChar(100)
  cidade       String   @db.VarChar(100)
  estado       String   @db.Char(2)
  principal    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("enderecos")
}

/// Sacola de compras de um cliente.
/// Cada usuário possui no máximo um carrinho.
model Carrinho {
  id           Int            @id @default(autoincrement())
  usuarioId    Int            @unique
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  usuario      Usuario        @relation(fields: [usuarioId], references: [id])
  itens        ItemCarrinho[]

  @@map("carrinhos")
}

/// Cada registro representa uma variante de produto
/// selecionada dentro de um carrinho.
model ItemCarrinho {
  id           Int             @id @default(autoincrement())
  carrinhoId   Int
  varianteId   Int
  quantidade   Int             @default(1)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  carrinho     Carrinho        @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  variante     VarianteProduto @relation(fields: [varianteId], references: [id])

  @@unique([carrinhoId, varianteId])
  @@index([varianteId], map: "itens_carrinho_varianteId_fkey")
  @@map("itens_carrinho")
}

/// Representa uma compra realizada na Pádua Culture.
model Pedido {
  id                   Int                    @id @default(autoincrement())
  usuarioId            Int
  status               StatusPedido           @default(AGUARDANDO_PAGAMENTO)
  subtotal             Decimal                @db.Decimal(10, 2)
  valorFrete           Decimal                @default(0.00) @db.Decimal(10, 2)
  valorDesconto        Decimal                @default(0.00) @db.Decimal(10, 2)
  valorTotal           Decimal                @db.Decimal(10, 2)
  criadoEm             DateTime               @default(now())
  atualizadoEm         DateTime               @updatedAt
  enderecoEntrega      EnderecoEntregaPedido?
  entrega              Entrega?
  itens                ItemPedido[]
  movimentacoesEstoque MovimentacaoEstoque[]
  pagamentos           Pagamento[]
  usuario              Usuario                @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([status])
  @@map("pedidos")
}

/// Produtos e valores registrados no pedido.
model ItemPedido {
  id            Int              @id @default(autoincrement())
  pedidoId      Int
  varianteId    Int?
  nomeProduto   String           @db.VarChar(150)
  tamanho       String           @db.VarChar(30)
  cor           String           @db.VarChar(60)
  quantidade    Int
  precoUnitario Decimal          @db.Decimal(10, 2)
  subtotal      Decimal          @db.Decimal(10, 2)
  pedido        Pedido           @relation(fields: [pedidoId], references: [id])
  variante      VarianteProduto? @relation(fields: [varianteId], references: [id])

  @@index([pedidoId])
  @@index([varianteId])
  @@map("itens_pedido")
}

/// Endereço de entrega preservado no histórico do pedido.
model EnderecoEntregaPedido {
  id           Int     @id @default(autoincrement())
  pedidoId     Int     @unique
  destinatario String  @db.VarChar(150)
  cep          String  @db.VarChar(8)
  logradouro   String  @db.VarChar(200)
  numero       String  @db.VarChar(20)
  complemento  String? @db.VarChar(150)
  bairro       String  @db.VarChar(100)
  cidade       String  @db.VarChar(100)
  estado       String  @db.Char(2)
  pedido       Pedido  @relation(fields: [pedidoId], references: [id])

  @@map("enderecos_entrega_pedido")
}

/// Registra uma cobrança associada a um pedido.
model Pagamento {
  id                   Int                  @id @default(autoincrement())
  pedidoId             Int
  metodo               MetodoPagamento
  status               StatusPagamento      @default(PENDENTE)
  valor                Decimal              @db.Decimal(10, 2)
  identificadorExterno String?
  criadoEm             DateTime             @default(now())
  atualizadoEm         DateTime             @updatedAt
  pagoEm               DateTime?
  pedido               Pedido               @relation(fields: [pedidoId], references: [id])
  transacoes           TransacaoPagamento[]

  @@index([pedidoId])
  @@index([status])
  @@map("pagamentos")
}

/// Histórico de operações realizadas no provedor de pagamentos.
model TransacaoPagamento {
  id                   Int       @id @default(autoincrement())
  pagamentoId          Int
  tipo                 String    @db.VarChar(50)
  status               String    @db.VarChar(50)
  identificadorExterno String?
  valor                Decimal   @db.Decimal(10, 2)
  criadoEm             DateTime  @default(now())
  pagamento            Pagamento @relation(fields: [pagamentoId], references: [id])

  @@index([pagamentoId])
  @@index([identificadorExterno])
  @@map("transacoes_pagamento")
}

/// Informações logísticas de um pedido da Pádua Culture.
/// Cada pedido poderá possuir uma entrega.
model Entrega {
  id                 Int           @id @default(autoincrement())
  pedidoId           Int           @unique
  transportadora     String?       @db.VarChar(100)
  modalidadeFrete    String?       @db.VarChar(100)
  codigoRastreamento String?       @db.VarChar(150)
  urlRastreamento    String?       @db.VarChar(1000)
  status             StatusEntrega @default(PENDENTE)
  previsaoEntrega    DateTime?
  dataPostagem       DateTime?
  dataEntrega        DateTime?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt
  pedido             Pedido        @relation(fields: [pedidoId], references: [id])

  @@index([status])
  @@index([codigoRastreamento])
  @@map("entregas")
}

/// Histórico de movimentações de estoque da Pádua Culture.
/// Cada movimentação pertence a uma variante de produto.
model MovimentacaoEstoque {
  id             Int                     @id @default(autoincrement())
  varianteId     Int
  pedidoId       Int?
  tipo           TipoMovimentacaoEstoque
  quantidade     Int
  motivo         String?                 @db.VarChar(255)
  saldoAnterior  Int
  saldoPosterior Int
  criadoEm       DateTime                @default(now())
  pedido         Pedido?                 @relation(fields: [pedidoId], references: [id])
  variante       VarianteProduto         @relation(fields: [varianteId], references: [id])

  @@index([varianteId, criadoEm])
  @@index([pedidoId])
  @@index([tipo])
  @@map("movimentacoes_estoque")
}

enum Perfil {
  CLIENTE
  ADMIN
}

/// Situação operacional do pedido.
/// O status financeiro será controlado separadamente.
enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  CONFIRMADO
  EM_PREPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

/// Métodos de pagamento inicialmente aceitos.
enum MetodoPagamento {
  PIX
  CARTAO
}

/// Situações financeiras de uma cobrança.
enum StatusPagamento {
  PENDENTE
  PROCESSANDO
  APROVADO
  RECUSADO
  CANCELADO
  EXPIRADO
  ESTORNADO
}

/// Situação do processo de entrega.
enum StatusEntrega {
  PENDENTE
  PREPARANDO
  POSTADO
  EM_TRANSITO
  SAIU_PARA_ENTREGA
  ENTREGUE
  FALHA_ENTREGA
  DEVOLVIDO
  CANCELADO
}

/// Tipos de movimentação realizados no estoque.
enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  RESERVA
  LIBERACAO_RESERVA
  AJUSTE
}
